pipeline {
    agent any

    parameters {
        string(name: 'OS', defaultValue: 'Windows', description: 'Target Operating System')
        string(name: 'OS_VERSION', defaultValue: '11', description: 'Target OS Version')
        string(name: 'BROWSER', defaultValue: 'Chrome', description: 'Target Browser')
        string(name: 'BROWSER_VERSION', defaultValue: 'latest', description: 'Target Browser Version')
    }

    environment {
        // Retrieves credentials securely from Jenkins Credentials Provider
        BROWSERSTACK_USERNAME   = credentials('browserstack-username-id')
        BROWSERSTACK_ACCESS_KEY = credentials('browserstack-access-key-id')
    }

    stages {
        stage('Checkout') {
            steps {
                // Clones your specific master branch directly
                git branch: 'master', url: 'https://github.com/samruddhiingale1-cloud/AiEngineeringassignment.git'
            }
        }

        stage('Validate Credentials') {
            steps {
                script {
                    if (!env.BROWSERSTACK_USERNAME || !env.BROWSERSTACK_ACCESS_KEY) {
                        error "Missing Credentials: Ensure browserstack-username-id and browserstack-access-key-id are configured in Jenkins credentials."
                    }
                }
            }
        }

        stage('Execute Test Suite') {
            steps {
                // Executes TestNG passing parameters via Windows batch command
                bat "mvn clean test -Dos=${params.OS} -DosVersion=${params.OS_VERSION} -DbrowserName=${params.BROWSER} -DbrowserVersion=${params.BROWSER_VERSION}"
            }
            
            // FIXED: Moved the post-reporting blocks inside the stage so they execute within the running node context
            post {
                always {
                    junit '**/target/surefire-reports/*.xml'
                    archiveArtifacts artifacts: '**/target/surefire-reports/**/*', fingerprint: true
                }
            }
        }
    }
}
